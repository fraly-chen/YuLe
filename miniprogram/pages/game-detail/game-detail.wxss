/* pages/game-detail/game-detail.wxss */
page {
  background: #F5F7FA;
  padding-bottom: 0rpx;
}

.container {
  min-height: 100vh;
}

/* 球局头部 */
.game-header {
  background: #fff;
  padding: 30rpx;
  text-align: center;
}

.game-name {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
}

/* 球局状态卡片 */
.status-card {
  margin: 20rpx 00rpx;
  padding: 80rpx;
  border-radius: 100rpx;
  width: 70%;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.08);
}

.status-card.waiting {
  background: linear-gradient(135deg, #00BFFF 0%, #46C7FF 100%);
}

.status-card.playing {
  background: linear-gradient(135deg, #9fc48d 0%, #9fc48d 100%);
}

.status-card.finished {
  background: linear-gradient(135deg, #90a4ae 0%, #78909c 100%);
}

.status-content {
  flex: 1;
}

.status-label {
  display: block;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.7);
  margin-bottom: 12rpx;
}

.status-value {
  display: block;
  font-size: 48rpx;
  font-weight: bold;
  color: #fff;
  margin-bottom: 20rpx;
}

/* 预计轮数公式 */
.round-formula {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 16rpx;
  padding: 12rpx 20rpx;
  background: rgba(255, 255, 255, 0.15);
  border-radius: 20rpx;
  backdrop-filter: blur(8rpx);
}

.formula-text {
  font-size: 28rpx;
  font-weight: 600;
  color: #fff;
}

.formula-detail {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.7);
  font-style: italic;
}

.location-info {
  display: flex;
  align-items: center;
}

.location-pin {
  font-size: 28rpx;
  margin-right: 8rpx;
  color: rgba(255, 255, 255, 0.9);
}

.location-text {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.9);
}

.player-count {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.25);
  padding: 30rpx;
  border-radius: 50%;
  min-width: 160rpx;
  min-height: 160rpx;
  backdrop-filter: blur(8rpx);
}

.count-number {
  font-size: 60rpx;
  font-weight: bold;
  color: #fff;
  line-height: 1;
  margin-bottom: 8rpx;
}

.count-label {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.9);
}

.count-full {
  display: inline-block;
  background: #ff6b6b;
  color: #fff;
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 16rpx;
  margin-top: 8rpx;
}

/* 参与人员部分 */
.participants-section {
  background: #FFFFFF;
  margin: 20rpx 30rpx;
  padding: 30rpx;
  border-radius: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
  border: 2rpx solid #EAEAEA;
  width: 70%;
}

.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 30rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}

.round-info {
  font-size: 26rpx;
  color: #4A6FA5;
  padding: 8rpx 20rpx;
  background: #E8EEF5;
  border-radius: 20rpx;
  font-weight: 500;
}

.start-btn {
  height: 64rpx;
  line-height: 64rpx;
  padding: 0 36rpx;
  background: linear-gradient(135deg, #4A6FA5 0%, #5B8DBE 100%);
  color: #fff;
  border-radius: 32rpx;
  font-size: 26rpx;
  font-weight: 500;
}

.test-btn {
  margin-top: 30rpx;
  height: 72rpx;
  line-height: 72rpx;
  background: #f0f0f0;
  color: #666;
  border-radius: 36rpx;
  font-size: 28rpx;
  border: 2rpx dashed #ccc;
}

.leave-btn {
  margin-top: 30rpx;
  height: 80rpx;
  line-height: 80rpx;
  background: transparent;
  color: #F44336;
  border-radius: 40rpx;
  font-size: 30rpx;
  border: 2rpx solid #F44336;
  font-weight: 500;
  text-align: center;
  display: flex;
  align-items: center;
  justify-content: center;
}

.leave-btn::after {
  border: none;
}

.participants-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 24rpx;
}

.participant-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.participant-avatar-wrap {
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  margin-bottom: 12rpx;
  overflow: hidden;
  background: #f5f5f5;
  border: 4rpx solid #fff;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
}

.participant-avatar {
  width: 100%;
  height: 100%;
}

.participant-avatar-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  background: linear-gradient(135deg, #e0e0e0 0%, #f5f5f5 100%);
}

.participant-info {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.participant-name {
  font-size: 26rpx;
  color: #333;
  text-align: center;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 140rpx;
  font-weight: 500;
}

.participant-extra {
  display: flex;
  align-items: center;
  margin-top: 4rpx;
}

.participant-extra .gender-icon {
  font-size: 22rpx;
}

.participant-extra .gender-icon.male {
  color: #4A6FA5;
}

.participant-extra .gender-icon.female {
  color: #ff6b81;
}

.participant-extra .level-tag {
  font-size: 20rpx;
  color: #666;
  margin-left: 4rpx;
  background: #F5F7FA;
  padding: 2rpx 8rpx;
  border-radius: 8rpx;
}

.creator-tag {
  padding: 6rpx 16rpx;
  background: linear-gradient(135deg, #FF9800 0%, #FFB74D 100%);
  color: #fff;
  border-radius: 16rpx;
  font-size: 20rpx;
  font-weight: 500;
  margin-top: 8rpx;
}

/* 空位（虚位以待） */
.empty-slot {
  opacity: 0.6;
}

.participant-avatar-wrap.empty {
  background: linear-gradient(135deg, #E8EEF5 0%, #F5F7FA 100%);
  border: 3rpx dashed #C0CCD8;
  display: flex;
  align-items: center;
  justify-content: center;
}

.empty-avatar-icon {
  font-size: 40rpx;
  color: #A0B0C0;
}

.participant-name.empty-text {
  color: #A0B0C0;
  font-size: 24rpx;
}

/* 当前轮次 */
.current-round-section {
  margin: 20rpx 30rpx;
}

/* 轮次导航 */
.round-nav {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #FFFFFF;
  padding: 24rpx;
  border-radius: 20rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.06);
  border: 2rpx solid #EAEAEA;
}

.nav-btn {
  padding: 16rpx 28rpx;
  font-size: 26rpx;
  background: #F5F7FA;
  color: #333;
  border-radius: 28rpx;
  line-height: 1;
  font-weight: 500;
}

.nav-btn.disabled {
  color: #ccc;
  background: #fafafa;
}

.round-indicator {
  text-align: center;
}

.round-current {
  font-size: 32rpx;
  font-weight: bold;
  color: #4A6FA5;
}

.round-total {
  font-size: 24rpx;
  color: #999;
  margin-left: 8rpx;
}

/* 比赛卡片列表 */
.matches-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.match-card {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 24rpx;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.06);
  border: 2rpx solid #EAEAEA;
}

.court-label {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 16rpx;
  padding-bottom: 12rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.match-content {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.team-side {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  position: relative;
  padding: 16rpx;
  border-radius: 16rpx;
  transition: all 0.2s;
}

.team-side.clickable {
  background: #F8F9FB;
  border: 2rpx dashed #D0D5DD;
}

.team-side.clickable:active {
  background: #E8EEF5;
  border-color: #4A6FA5;
}

.team-side.winner {
  background: rgba(82, 196, 26, 0.12);
  border: 2rpx solid #52c41a;
}

.tap-hint {
  font-size: 22rpx;
  color: #999;
  text-align: center;
  margin-top: 8rpx;
}

.match-status {
  text-align: center;
  padding-top: 16rpx;
  border-top: 1rpx solid #f0f0f0;
  margin-top: 16rpx;
}

.status-done {
  font-size: 24rpx;
  color: #52c41a;
  font-weight: 500;
}

.player-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.player-avatar-small {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  overflow: hidden;
  background: #f5f5f5;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
}

.player-avatar-small image {
  width: 100%;
  height: 100%;
}

.player-name-small {
  font-size: 26rpx;
  color: #333;
  max-width: 100rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.player-tag {
  font-size: 22rpx;
  color: #4A6FA5;
  margin-left: 6rpx;
  flex-shrink: 0;
}

.win-badge {
  position: absolute;
  top: -8rpx;
  right: -8rpx;
  background: linear-gradient(135deg, #52c41a 0%, #73d13d 100%);
  color: #fff;
  font-size: 20rpx;
  padding: 8rpx 14rpx;
  border-radius: 14rpx;
  font-weight: 500;
}

.vs-divider {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 0 20rpx;
}

.vs-text {
  font-size: 28rpx;
  font-weight: bold;
  color: #999;
}

.score-text {
  font-size: 24rpx;
  color: #06d6a0;
  margin-top: 8rpx;
}

.match-actions {
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #f0f0f0;
  display: flex;
  justify-content: center;
}

.record-btn {
  background: linear-gradient(135deg, #4A6FA5 0%, #5B8DBE 100%);
  color: #fff;
  font-size: 26rpx;
  padding: 16rpx 40rpx;
  border-radius: 30rpx;
  line-height: 1;
}

.result-recorded {
  display: flex;
  align-items: center;
  gap: 8rpx;
  color: #06d6a0;
  font-size: 26rpx;
}

.result-icon {
  font-size: 28rpx;
}

/* 轮空玩家 */
.rest-players {
  background: #FFFBEB;
  padding: 20rpx 24rpx;
  border-radius: 16rpx;
  margin-top: 20rpx;
  display: flex;
  align-items: center;
  border: 2rpx solid #FEF3C7;
}

.rest-title {
  font-size: 26rpx;
  color: #faad14;
}

.rest-names {
  font-size: 26rpx;
  color: #666;
  flex: 1;
}

/* 轮次操作按钮 */
.round-actions {
  margin-top: 30rpx;
}

.next-round-btn-primary {
  background: linear-gradient(135deg, #4A6FA5 0%, #5B8DBE 100%);
  color: #fff;
  font-size: 32rpx;
  padding: 24rpx 0;
  border-radius: 40rpx;
  font-weight: 500;
}

.end-game-btn {
  background: linear-gradient(135deg, #FF9800 0%, #FFB74D 100%);
  color: #fff;
  font-size: 32rpx;
  padding: 24rpx 0;
  border-radius: 40rpx;
  font-weight: 500;
}

/* 已结束状态 */
.finished-section {
  margin: 40rpx 30rpx;
  padding: 60rpx 30rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
  text-align: center;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
  border: 2rpx solid #EAEAEA;
}

.finished-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 40rpx;
}

.finished-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.finished-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
}

.view-ranking-btn {
  background: linear-gradient(135deg, #4A6FA5 0%, #5B8DBE 100%);
  color: #fff;
  font-size: 32rpx;
  padding: 24rpx 60rpx;
  border-radius: 40rpx;
}

.player-name {
  font-size: 26rpx;
  color: #333;
}

.vs-text {
  font-size: 32rpx;
  font-weight: bold;
  color: #4A6FA5;
  margin: 0 20rpx;
}

/* 休息卡片 */
.rest-card {
  background: #fff9e6;
  padding: 60rpx;
  border-radius: 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 20rpx;
}

.rest-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.rest-text {
  font-size: 28rpx;
  color: #ffa726;
  margin-bottom: 30rpx;
}

.next-round-btn {
  padding: 16rpx 40rpx;
  background: #f5f5f5;
  color: #999;
  border-radius: 40rpx;
  font-size: 24rpx;
}

/* 分享部分 */
.share-section {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #fff;
  padding: 20rpx 30rpx;
  box-shadow: 0 -4rpx 12rpx rgba(0, 0, 0, 0.08);
}

.share-btn {
  width: 100%;
  height: 80rpx;
  background: linear-gradient(135deg, #00b4d8 0%, #06d6a0 100%);
  color: #fff;
  border-radius: 40rpx;
  font-size: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.share-icon {
  width: 36rpx;
  height: 36rpx;
  margin-right: 12rpx;
}

/* 结果弹窗 */
.result-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.6);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.modal-content {
  width: 600rpx;
  background: #fff;
  border-radius: 24rpx;
  padding: 40rpx;
}

.modal-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #333;
  text-align: center;
  margin-bottom: 30rpx;
}

.result-options {
  display: flex;
  gap: 20rpx;
  margin-bottom: 30rpx;
}

.result-option {
  flex: 1;
  height: 88rpx;
  border-radius: 44rpx;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.result-option.win {
  background: linear-gradient(135deg, #52c41a 0%, #73d13d 100%);
  color: #fff;
}

.result-option.lose {
  background: #f5f5f5;
  color: #666;
}

.score-input {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 20rpx;
  margin-bottom: 30rpx;
}

.score-field {
  width: 200rpx;
  height: 80rpx;
  text-align: center;
  background: #f5f5f5;
  border-radius: 12rpx;
  font-size: 32rpx;
}

.score-separator {
  font-size: 40rpx;
  font-weight: bold;
  color: #333;
}

.submit-result-btn {
  width: 100%;
  height: 88rpx;
  background: linear-gradient(135deg, #4A6FA5 0%, #5B8DBE 100%);
  color: #fff;
  border-radius: 44rpx;
  font-size: 30rpx;
  font-weight: 500;
}
