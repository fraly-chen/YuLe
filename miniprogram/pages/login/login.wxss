/* pages/login/login.wxss */
page {
  background: #ffffff;
  min-height: 100vh;
}

.container {
  display: flex;
  justify-content: center;
  align-items: center;
  min-height: 100vh;
  padding: 60rpx 0;
}

.login-card {
  width: 600rpx;
  background: #fff;
  border-radius: 40rpx;
  padding: 80rpx 60rpx;
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.2);
  display: flex;
  flex-direction: column;
  align-items: center;
}

.logo {
  width: 160rpx;
  height: 160rpx;
  margin-bottom: 30rpx;
}

.app-name {
  font-size: 48rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 16rpx;
}

.app-slogan {
  font-size: 28rpx;
  color: #999;
  margin-bottom: 80rpx;
}

.login-button {
  width: 100%;
  height: 88rpx;
  background: linear-gradient(135deg, #09bb07 0%, #06ae00 100%);
  border-radius: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  color: #fff;
  font-weight: 500;
  box-shadow: 0 8rpx 24rpx rgba(9, 187, 7, 0.3);
}

.wx-icon {
  width: 40rpx;
  height: 40rpx;
  margin-right: 16rpx;
}

.user-info-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 100%;
}

.avatar-large {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  margin-bottom: 30rpx;
  border: 6rpx solid #f0f0f0;
}

.welcome-text {
  font-size: 32rpx;
  color: #333;
  margin-bottom: 40rpx;
}

.continue-btn {
  width: 100%;
  height: 88rpx;
  background: linear-gradient(135deg, #00b4d8 0%, #06d6a0 100%);
  border-radius: 44rpx;
  font-size: 32rpx;
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(0, 180, 216, 0.3);
}

.tips {
  margin-top: 60rpx;
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  align-items: center;
}

.tip-text {
  font-size: 24rpx;
  color: #999;
}

.link-text {
  font-size: 24rpx;
  color: #00b4d8;
  text-decoration: underline;
}
