<view class="container">
  <!-- 前三名领奖台 - 根据rank动态显示 -->
  <view class="podium" wx:if="{{ranking.length >= 1}}">
    <!-- 按排名顺序显示领奖台选手 -->
    <block wx:for="{{ranking}}" wx:key="openid">
      <!-- 只显示前三名并且排名<=3的 -->
      <view class="podium-item {{item.rank === 1 ? 'first' : (item.rank === 2 ? 'second' : 'third')}}" 
            wx:if="{{item.rank <= 3 && index < 5}}">
        <view class="crown-icon" wx:if="{{item.rank === 1}}">👑</view>
        <view class="medal-icon {{item.medal}}">{{item.medalIcon}}</view>
        <view class="player-avatar-wrap {{item.rank === 1 ? 'champion' : ''}}">
          <image class="player-avatar-large" src="{{item.avatarUrl}}" wx:if="{{item.avatarUrl}}"></image>
          <view class="avatar-placeholder" wx:else>👤</view>
        </view>
        <text class="player-name-large {{item.rank === 1 ? 'champion' : ''}}">{{item.nickName}}</text>
        <view class="player-stats-large">
          <text class="stat-item">{{item.wins}}胜 {{item.losses}}负</text>
          <text class="stat-rate {{item.rank === 1 ? 'champion' : ''}}">{{item.winRateText}}</text>
        </view>
      </view>
    </block>
  </view>

  <!-- 完整排名列表 -->
  <view class="ranking-list" wx:if="{{ranking.length > 3}}">
    <view class="list-header">
      <text class="header-text">完整排名</text>
    </view>
    
    <view class="ranking-item" wx:for="{{ranking}}" wx:key="openid" wx:if="{{index >= 3}}">
      <view class="rank-number-normal">{{item.rank}}</view>
      <view class="player-avatar-small-wrap">
        <image class="player-avatar" src="{{item.avatarUrl}}" wx:if="{{item.avatarUrl}}"></image>
        <view class="avatar-placeholder-small" wx:else>👤</view>
      </view>
      <text class="player-name">{{item.nickName}}</text>
      <view class="player-stats">
        <text class="stat-text">{{item.playCount}}场</text>
        <text class="stat-text">{{item.wins}}胜</text>
        <text class="stat-text win-rate">{{item.winRateText}}</text>
      </view>
    </view>
  </view>

  <!-- 空状态 -->
  <view class="empty-state" wx:if="{{ranking.length === 0}}">
    <text class="empty-icon">📊</text>
    <text class="empty-text">暂无排名数据</text>
  </view>

  <!-- 底部按钮 -->
  <view class="bottom-actions">
    <button class="action-button secondary" open-type="share">
      📤 分享成绩
    </button>
    <button class="action-button primary" bindtap="onBackHome">
      🏠 返回首页
    </button>
  </view>
</view>
