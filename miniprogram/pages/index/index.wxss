/* pages/index/index.wxss */
page {
  background: #1a1400;
  height: 100vh;
  overflow: hidden;
}

.container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  box-sizing: border-box;
}

/* ========== 顶部Banner区域 ========== */
.banner-section {
  background: #f8f4e9;
  padding: 280rpx 180rpx 95rpx;
  position: relative;
  transition: all 0.3s ease;
  flex-shrink: 0;
  width: 50%;
  margin-bottom: -50px;
}

.banner-section.collapsed {
  padding: 40rpx 40rpx 20rpx;
}

.banner-content {
  display: flex;
  flex-direction: column;
}

.banner-title-light {
  font-size: 48rpx;
  color: rgba(0, 0, 0, 0.6);
  font-weight: 300;
  letter-spacing: 4rpx;
}

.banner-title-bold {
  font-size: 56rpx;
  color: #000;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.banner-icon {
  position: absolute;
  right: 40rpx;
  top: 50%;
  transform: translateY(-50%);
  font-size: 80rpx;
  opacity: 0.8;
}

/* ========== 中间个人信息卡片 ========== */
.user-card {
  background: #6b5f38;
  margin: 0;
  border-radius: 0;
  padding: 24rpx 40rpx;
  padding-bottom: 75rpx;
  transition: all 0.3s ease;
  flex-shrink: 0;
  position: relative;
  z-index: 1;
  height: 50%;
  width: 88%;
  padding-top: 5%;
  border-radius: 30px 30px 0px 0px;
}

.user-card.expanded {
  padding-bottom: 0rpx;
  z-index: 3;
}

.user-card-header {
  display: flex;
  align-items: center;
}

.user-avatar-wrap {
  width: 90rpx;
  height: 90rpx;
  border-radius: 50%;
  overflow: hidden;
  border: 4rpx solid rgba(255,255,255,0.3);
  background: rgba(255,255,255,0.2);
  flex-shrink: 0;
}

.user-avatar-img {
  width: 100%;
  height: 100%;
}

.user-avatar-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
}

.user-nickname {
  flex: 1;
  font-size: 34rpx;
  font-weight: 600;
  color: #000;
  margin-left: 20rpx;
}

.user-actions {
  display: flex;
  gap: 20rpx;
}

.action-icon {
  font-size: 36rpx;
  opacity: 0.7;
}

/* 展开后的详细信息 */
.user-detail {
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid rgba(0,0,0,0.1);
}

.stat-row {
  display: flex;
  justify-content: space-around;
  margin-bottom: 24rpx;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-value {
  font-size: 40rpx;
  font-weight: 700;
  color: #000;
}

.stat-label {
  font-size: 24rpx;
  color: rgba(0,0,0,0.6);
  margin-top: 4rpx;
}

.fix-btn {
  opacity: 0.6;
}

.fix-btn:active {
  opacity: 1;
}

.edit-profile-btn {
  width: 100%;
  height: 72rpx;
  background: rgba(0,0,0,0.1);
  color: #000;
  font-size: 28rpx;
  border-radius: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.edit-profile-btn::after {
  border: none;
}

/* 编辑资料表单 */
.profile-form {
  margin-top: 20rpx;
  background: rgba(0,0,0,0.05);
  border-radius: 16rpx;
  padding: 0 20rpx;
}

.profile-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0;
  border-bottom: 1rpx solid rgba(0,0,0,0.08);
}

.profile-item:last-child {
  border-bottom: none;
}

.profile-label {
  font-size: 28rpx;
  color: #333;
}

.profile-value {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.profile-text {
  font-size: 28rpx;
  color: #f8f4e9;
}

.profile-arrow {
  font-size: 32rpx;
  color: #f8f4e9;
}

/* 性别按钮 */
.gender-btns {
  display: flex;
  gap: 16rpx;
}

.gender-btn {
  display: flex;
  align-items: center;
  gap: 4rpx;
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  background: rgba(0,0,0,0.05);
  font-size: 26rpx;
  color: #f8f4e9;
}

.gender-btn.active {
  background: #000;
  color: #FFD700;
}

.gender-icon.male {
  color: #1890ff;
}

.gender-icon.female {
  color: #eb2f96;
}

.gender-btn.active .gender-icon {
  color: #FFD700;
}

/* 保存按钮 */
.save-profile-btn {
  width: 100%;
  height: 72rpx;
  background: #3a3000;
  color: #aea886;
  font-size: 28rpx;
  font-weight: 600;
  border-radius: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 24rpx;
}

.save-profile-btn::after {
  border: none;
}

.login-btn-card {
  width: 100%;
  height: 72rpx;
  background: #1a1400;
  color: #b89b5e;
  font-size: 28rpx;
  font-weight: 600;
  border-radius: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.login-btn-card::after {
  border: none;
}

.expand-hint {
  display: flex;
  justify-content: center;
  margin-top: 12rpx;
}

.expand-arrow {
  font-size: 20rpx;
  color: rgba(0,0,0,0.4);
}

/* ========== 底部球局区域 ========== */
.game-section {
  flex: 1;
  padding-top: 4%;
  background: #2a2000;
  border-radius: 40rpx 40rpx 0 0;
  margin-top: -750rpx;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  transition: all 0.3s ease;
  position: relative;
  z-index: 2;
  width: 100%;
  border-radius: 30px 30px 0px 0px;
}

.game-section.expanded {
  flex: 2;
}

/* 用户卡片展开时，球局区域轻微重叠且显示在上层 */
.user-card.expanded + .game-section {
  margin-top: -82rpx;
  z-index: 4;
}

.game-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx 40rpx;
  flex-shrink: 0;
}

.game-header-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.game-icon {
  font-size: 36rpx;
}

.game-header-title {
  font-size: 28rpx;
  color: #fff;
  opacity: 0.8;
}

.game-add-btn {
  width: 70rpx;
  height: 50rpx;
  background: #b89b5e;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.add-icon {
  font-size: 36rpx;
  color: #000;
  font-weight: bold;
}

/* 球局内容区域 */
.game-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  padding: 0 30rpx;
}

.game-scroll {
  flex: 1;
  min-height: 0;
}

.game-item-wrap {
  position: relative;
  margin-bottom: 16rpx;
  overflow: hidden;
}

.delete-btn {
  position: absolute;
  right: 0;
  top: 0;
  bottom: 0;
  width: 140rpx;
  background: #ff4d4f;
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  border-radius: 16rpx;
}

.game-item {
  display: flex;
  align-items: center;
  padding: 24rpx;
  background: #3a3000;
  border-radius: 16rpx;
  position: relative;
  z-index: 1;
  transition: transform 0.2s;
}

.game-info {
  flex: 1;
}

.game-name {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #fff;
  margin-bottom: 8rpx;
}

.game-meta {
  display: flex;
  gap: 16rpx;
}

.game-time {
  font-size: 24rpx;
  color: rgba(255,255,255,0.5);
}

.game-right {
  text-align: right;
}

.game-status {
  display: inline-block;
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  margin-bottom: 8rpx;
}

.game-status.waiting {
  background: rgba(255,215,0,0.2);
  color: #FFD700;
}

.game-status.playing {
  background: rgba(0,210,106,0.2);
  color: #FFD700;
}

.game-status.finished {
  background: rgba(153,153,153,0.2);
  color: #999;
}

.game-players {
  display: block;
  font-size: 24rpx;
  color: rgba(255,255,255,0.6);
}

/* ========== 空状态动画 ========== */
.empty-state {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
}

.empty-animation {
  position: relative;
  width: 400rpx;
  height: 300rpx;
  margin-bottom: 40rpx;
}

.court-bg {
  width: 100%;
  height: 100%;
  background: #0a3d0a;
  border-radius: 16rpx;
  position: relative;
  border: 4rpx solid #1a5a1a;
}

.court-line {
  position: absolute;
  background: rgba(255,255,255,0.3);
}

.court-line-h {
  width: 100%;
  height: 2rpx;
  top: 50%;
  left: 0;
}

.court-line-v {
  width: 2rpx;
  height: 100%;
  left: 50%;
  top: 0;
}

.court-net {
  position: absolute;
  width: 100%;
  height: 6rpx;
  top: 50%;
  left: 0;
  transform: translateY(-50%);
  background: repeating-linear-gradient(
    90deg,
    rgba(255,255,255,0.5) 0px,
    rgba(255,255,255,0.5) 8rpx,
    transparent 8rpx,
    transparent 16rpx
  );
}

.empty-shuttle {
  position: absolute;
  top: 30%;
  left: 50%;
  transform: translate(-50%, -50%);
  font-size: 60rpx;
  animation: shuttle-bounce 2s ease-in-out infinite;
}

@keyframes shuttle-bounce {
  0%, 100% {
    transform: translate(-50%, -50%) translateY(0) rotate(0deg);
  }
  25% {
    transform: translate(-50%, -50%) translateY(-40rpx) rotate(15deg);
  }
  50% {
    transform: translate(-50%, -50%) translateY(0) rotate(0deg);
  }
  75% {
    transform: translate(-50%, -50%) translateY(-30rpx) rotate(-15deg);
  }
}

.empty-tip {
  display: flex;
  align-items: center;
  background: #c9a96e;
  padding: 20rpx 30rpx;
  border-radius: 40rpx;
  gap: 8rpx;
}

.empty-bracket {
  font-size: 28rpx;
  color: #000;
}

.empty-text {
  font-size: 28rpx;
  color: #000;
  font-weight: 600;
}

.empty-hint {
  font-size: 28rpx;
  color: #000;
  margin-left: 8rpx;
}

.empty-arrow {
  width: 50rpx;
  height: 50rpx;
  background: #1a1400;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #FFD700;
  font-size: 24rpx;
  margin-left: 12rpx;
}

/* ========== 编辑资料弹窗 ========== */
.edit-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0,0,0,0.6);
  z-index: 999;
}

.edit-sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #fff;
  border-radius: 32rpx 32rpx 0 0;
  padding: 0 40rpx 60rpx;
  padding-bottom: calc(60rpx + env(safe-area-inset-bottom));
  z-index: 1000;
  transform: translateY(100%);
  transition: transform 0.3s ease;
}

.edit-sheet.show {
  transform: translateY(0);
}

.edit-input {
  width: 100%;
  height: 88rpx;
  background: #f5f5f5;
  border-radius: 16rpx;
  padding: 0 24rpx;
  font-size: 30rpx;
  margin: 30rpx 0;
  box-sizing: border-box;
}

/* 级别列表 */
.level-list {
  padding: 20rpx 0;
}

.level-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 20rpx;
  border-radius: 12rpx;
  margin-bottom: 12rpx;
  background: #f5f5f5;
  font-size: 30rpx;
  color: #333;
}

.level-item.active {
  background: #FFD700;
  color: #000;
}

.check-icon {
  color: #000;
  font-weight: bold;
}

/* ========== 登录弹窗 ========== */
.login-mask, .create-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0,0,0,0.6);
  z-index: 999;
}

.login-sheet, .create-sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #fff;
  border-radius: 32rpx 32rpx 0 0;
  padding: 0 40rpx 60rpx;
  padding-bottom: calc(60rpx + env(safe-area-inset-bottom));
  z-index: 1000;
  transform: translateY(100%);
  transition: transform 0.3s ease;
}

.login-sheet.show, .create-sheet.show {
  transform: translateY(0);
}

.sheet-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.sheet-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
}

.sheet-close {
  font-size: 40rpx;
  color: #999;
  line-height: 1;
}

.sheet-body {
  padding: 20rpx 0;
}

.login-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.login-label {
  font-size: 28rpx;
  color: #333;
  width: 100rpx;
  flex-shrink: 0;
}

.avatar-choose-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  padding: 0;
  margin: 0;
  background: transparent;
}

.avatar-choose-btn::after {
  border: none;
}

.avatar-preview {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
}

.avatar-placeholder-sm {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: #f0f0f0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
}

.item-hint {
  font-size: 24rpx;
  color: #FFD700;
  margin-left: 16rpx;
}

.nickname-wrap {
  flex: 1;
  display: flex;
  justify-content: flex-end;
}

.nickname-input-visible {
  width: 300rpx;
  height: 64rpx;
  background: #f5f5f5;
  border-radius: 32rpx;
  padding: 0 24rpx;
  font-size: 26rpx;
  text-align: right;
}

.sheet-confirm-btn {
  width: 100%;
  height: 88rpx;
  background: #FFD700;
  color: #000;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 30rpx;
}

.sheet-confirm-btn::after {
  border: none;
}

/* ========== 创建球局弹窗 ========== */
.create-form {
  padding: 20rpx 0;
}

.form-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.form-label {
  font-size: 30rpx;
  color: #333;
  flex-shrink: 0;
}

.form-input {
  flex: 1;
  text-align: right;
  font-size: 30rpx;
  color: #333;
  margin-left: 20rpx;
}

.stepper {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.stepper-btn {
  width: 60rpx;
  height: 60rpx;
  background: #f5f5f5;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  color: #333;
}

.stepper-value {
  font-size: 34rpx;
  font-weight: 600;
  color: #333;
  min-width: 60rpx;
  text-align: center;
}
